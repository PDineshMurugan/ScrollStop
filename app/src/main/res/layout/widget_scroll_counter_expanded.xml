<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Top Section: Clean Counters (Reels & Shorts side-by-side, centered) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Instagram Reels Column -->
        <LinearLayout
            android:id="@+id/card_insta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_badge_insta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_insta_badge"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Reels"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_insta_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_insta_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0m"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Vertical Hairline Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="56dp"
            android:background="#1AFFFFFF"
            android:contentDescription="@null" />

        <!-- YouTube Shorts Column -->
        <LinearLayout
            android:id="@+id/card_yt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_badge_yt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_yt_badge"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Shorts"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_yt_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_yt_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0m"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#14FFFFFF"
        android:contentDescription="@null" />

    <!-- Bottom Half: 7-Day Activity Time Bars Container (Centered vertically) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.05"
                android:text="LAST 7 DAYS"
                android:textColor="#71717A"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_weekly_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="0m this week"
                android:textColor="#94A3B8"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 7-Day Time Bar Chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <!-- Day 0 (6 days ago) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bar_val_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#71717A"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/iv_bar_0"
                    android:layout_width="14dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_bar_past" />

                <TextView
                    android:id="@+id/tv_bar_day_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="M"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Day 1 (5 days ago) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bar_val_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#71717A"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/iv_bar_1"
                    android:layout_width="14dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_bar_past" />

                <TextView
                    android:id="@+id/tv_bar_day_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="T"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Day 2 (4 days ago) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bar_val_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#71717A"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/iv_bar_2"
                    android:layout_width="14dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_bar_past" />

                <TextView
                    android:id="@+id/tv_bar_day_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="W"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Day 3 (3 days ago) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bar_val_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#71717A"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/iv_bar_3"
                    android:layout_width="14dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_bar_past" />

                <TextView
                    android:id="@+id/tv_bar_day_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="T"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Day 4 (2 days ago) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bar_val_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#71717A"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/iv_bar_4"
                    android:layout_width="14dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_bar_past" />

                <TextView
                    android:id="@+id/tv_bar_day_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="F"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Day 5 (yesterday) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bar_val_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#71717A"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/iv_bar_5"
                    android:layout_width="14dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_bar_past" />

                <TextView
                    android:id="@+id/tv_bar_day_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="S"
                    android:textColor="#71717A"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Day 6 (TODAY) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal|bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bar_val_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#10B981"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_bar_6"
                    android:layout_width="14dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_bar_today" />

                <TextView
                    android:id="@+id/tv_bar_day_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="Today"
                    android:textColor="#10B981"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
